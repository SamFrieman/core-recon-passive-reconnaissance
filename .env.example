# CoreRecon — Environment Variables
# Copy this file to .env and fill in values before running locally.

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite (./corerecon.db) when not set.
# Set to a PostgreSQL connection string for production.
# DATABASE_URL=postgresql://user:password@localhost:5432/corerecon

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost:5173 when not set (development only).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Admin Authentication ───────────────────────────────────────────────────────
# Required to access /api/v1/health and /api/v1/history.
# Leave unset to disable admin endpoints entirely.
# CORERECON_ADMIN_TOKEN=your-secret-token-here

# ── Scan Cache ────────────────────────────────────────────────────────────────
# How long (seconds) to cache scan results before re-running.
# Default: 300 (5 minutes)
# SCAN_CACHE_TTL=300
